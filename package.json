{
  "name": "SYNERGY | Ivanti MCP",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "budget": "vitest run src/tools/description-budget.test.ts --silent=false --reporter=default",
    "manifest:size": "node --import tsx scripts/manifest-size.ts",
    "usage:report": "node --import tsx scripts/usage-report.ts",
    "handbook:sync": "node --import tsx scripts/handbook-data.mjs --write",
    "handbook:check": "node --import tsx scripts/handbook-data.mjs --check",
    "version:sync": "node scripts/check-version.mjs --sync",
    "version:check": "node scripts/check-version.mjs --check",
    "check:examples": "node scripts/check-example-envs.mjs",
    "check:licenses": "node scripts/check-license-headers.mjs && node scripts/third-party-notices.mjs --check",
    "licenses": "node scripts/third-party-notices.mjs",
    "check:docker": "node scripts/check-docker-context.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "license": "LicenseRef-SYNERGY-Commercial",
  "author": "SYNERGY (https://www.synergy.eu)"
}
